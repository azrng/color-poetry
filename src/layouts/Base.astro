---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  /** 当前颜色的 HEX，注入为整站强调色 */
  hex?: string;
}

const { title, description, hex } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const ogUrl = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-CN" style={hex ? `--accent:${hex}` : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:site_name" content="ColorPoetry 中国传统颜色" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={ogUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content={hex ?? '#f4f1ea'} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <ClientRouter />
  </head>
  <body>
    <slot />
  </body>
</html>

<script>
  // 图片灯箱：点击文章图片放大查看；Esc / 点遮罩 / 点图片关闭，左右方向键切换
  let box: HTMLDialogElement | null = null;
  let images: HTMLImageElement[] = [];
  let index = 0;

  function renderLightbox() {
    if (!box) return;
    const view = box.querySelector('.lightbox-img') as HTMLImageElement;
    const source = images[index];
    view.src = source.currentSrc || source.src;
    view.alt = source.alt;
    const caption = box.querySelector('.lightbox-caption');
    if (caption) caption.textContent = source.alt;
    const multiple = images.length > 1;
    const counter = box.querySelector('.lightbox-counter');
    if (counter) counter.textContent = multiple ? `${index + 1} / ${images.length}` : '';
    box.querySelector('.lightbox-prev')?.toggleAttribute('hidden', !multiple);
    box.querySelector('.lightbox-next')?.toggleAttribute('hidden', !multiple);
  }

  function step(delta: number) {
    if (!images.length) return;
    index = (index + delta + images.length) % images.length;
    renderLightbox();
  }

  function openLightbox(target: HTMLImageElement) {
    const scope = target.closest('.prose');
    images = scope ? Array.from(scope.querySelectorAll('img')) : [target];
    index = Math.max(0, images.indexOf(target));

    box = document.createElement('dialog');
    box.className = 'lightbox';
    box.innerHTML = `
      <img class="lightbox-img" alt="" />
      <span class="lightbox-counter"></span>
      <button class="lightbox-close" type="button" aria-label="关闭">×</button>
      <button class="lightbox-nav lightbox-prev" type="button" aria-label="上一张">‹</button>
      <button class="lightbox-nav lightbox-next" type="button" aria-label="下一张">›</button>
      <p class="lightbox-caption"></p>
    `;
    box.querySelector('.lightbox-close')?.addEventListener('click', () => box?.close());
    box.querySelector('.lightbox-prev')?.addEventListener('click', () => step(-1));
    box.querySelector('.lightbox-next')?.addEventListener('click', () => step(1));
    box.querySelector('.lightbox-img')?.addEventListener('click', () => box?.close());
    box.addEventListener('click', (e) => {
      // 点到空白遮罩处关闭
      if (!(e.target as Element).closest('.lightbox-img, .lightbox-nav, .lightbox-close')) {
        box?.close();
      }
    });
    box.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') step(-1);
      if (e.key === 'ArrowRight') step(1);
    });
    // 触摸滑动切图：横向位移超阈值且明显大于纵向位移时翻页
    let touchX = 0;
    let touchY = 0;
    box.addEventListener(
      'touchstart',
      (e) => {
        const t = e.changedTouches[0];
        touchX = t.clientX;
        touchY = t.clientY;
      },
      { passive: true },
    );
    box.addEventListener(
      'touchend',
      (e) => {
        const t = e.changedTouches[0];
        const dx = t.clientX - touchX;
        const dy = t.clientY - touchY;
        if (Math.abs(dx) > 48 && Math.abs(dx) > Math.abs(dy) * 1.5) {
          step(dx < 0 ? 1 : -1);
        }
      },
      { passive: true },
    );
    box.addEventListener('close', () => {
      document.body.style.overflow = '';
      box?.remove();
      box = null;
      images = [];
    });

    document.body.appendChild(box);
    document.body.style.overflow = 'hidden';
    box.showModal();
    renderLightbox();
  }

  // 委托在 document 上，视图过渡换页后依然有效
  document.addEventListener('click', (e) => {
    const img = (e.target as Element).closest?.('.prose img');
    if (img instanceof HTMLImageElement) openLightbox(img);
  });
</script>
