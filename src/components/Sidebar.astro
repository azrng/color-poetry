---
import { groupByFamily, colorFamily, FAMILY_NAMES } from '../lib/color';

interface ColorItem {
  id: string;
  data: { name: string; slug?: string; hex: string; order: number };
}

interface Props {
  colors: ColorItem[];
  currentId?: string;
}

const { colors, currentId } = Astro.props;
const groups = groupByFamily(colors);
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const searchable = (c: ColorItem) =>
  `${c.data.name} ${c.data.slug ?? c.id} ${c.data.hex} ${FAMILY_NAMES[colorFamily(c.data.hex)]}`.toLowerCase();
---

{/* 移动端顶栏：桌面端隐藏，仅 ≤900px 显示 */}
<header class="mobile-bar">
  <a class="brand" href={`${base}/`}>
    <span class="brand-mark" aria-hidden="true">色</span>
    <span>
      <span class="brand-latin">ColorPoetry</span>
      <span class="brand-cn">中国传统颜色</span>
    </span>
  </a>
  <button
    class="drawer-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="color-drawer"
  >
    <svg class="ico" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
      <rect x="1" y="1" width="6.5" height="6.5" rx="2"></rect>
      <rect x="8.5" y="1" width="6.5" height="6.5" rx="2"></rect>
      <rect x="1" y="8.5" width="6.5" height="6.5" rx="2"></rect>
      <rect x="8.5" y="8.5" width="6.5" height="6.5" rx="2"></rect>
    </svg>
    颜色列表
  </button>
</header>

<aside class="sidebar" id="color-drawer">
  <button class="drawer-close" type="button" aria-label="关闭颜色列表">×</button>
  <a class="brand" href={`${base}/`}>
    <span class="brand-mark" aria-hidden="true">色</span>
    <span>
      <span class="brand-latin">ColorPoetry</span>
      <span class="brand-cn">中国传统颜色</span>
    </span>
  </a>
  <input
    class="color-search"
    type="search"
    placeholder="搜索颜色"
    aria-label="搜索颜色"
    data-target="#color-nav"
    data-empty="#sidebar-empty"
  />
  <p class="list-empty" id="sidebar-empty" hidden>没有匹配的颜色</p>
  <nav class="color-nav" id="color-nav" aria-label="颜色列表">
    {
      groups.map((g) => (
        <div class="color-group">
          <p class="group-name">{g.name}</p>
          {g.colors.map((c) => (
            <a
              class:list={['color-item', { active: c.id === currentId }]}
              style={`--c:${c.data.hex}`}
              href={`${base}/color/${c.id}/`}
              data-search={searchable(c)}
            >
              <span class="sw" aria-hidden="true" />
              <span>
                <span class="cn">{c.data.name}</span>
                <span class="py">{(c.data.slug ?? c.id).toUpperCase()}</span>
              </span>
              <span class="hexcode">{c.data.hex}</span>
            </a>
          ))}
        </div>
      ))
    }
  </nav>
  <a class="repo" href="https://github.com/azrng/color-poetry" target="_blank" rel="noopener">
    GitHub 仓库
  </a>
</aside>

{/* 抽屉遮罩：点击关闭抽屉，桌面端隐藏 */}
<div class="drawer-backdrop" aria-hidden="true"></div>

<script>
  // 进入页面时把当前颜色滚动到可视区
  document.addEventListener('astro:page-load', () => {
    document
      .querySelector('.color-nav .color-item.active')
      ?.scrollIntoView({ block: 'nearest' });
    // 视图过渡换页后兜底关闭抽屉，避免残留打开状态
    setDrawer(false);
  });

  // 移动端抽屉开关：data-open 挂在侧栏上，换页后随新 DOM 自动回到关闭态
  function setDrawer(open: boolean) {
    const drawer = document.getElementById('color-drawer');
    if (!drawer) return;
    drawer.toggleAttribute('data-open', open);
    document
      .querySelector('.drawer-toggle')
      ?.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  }

  // 事件委托在 document 上，页面切换后依然有效
  document.addEventListener('click', (e) => {
    const t = e.target as Element;
    if (t.closest('.drawer-toggle')) setDrawer(true);
    else if (t.closest('.drawer-close') || t.closest('.drawer-backdrop')) setDrawer(false);
    // 点选颜色后立即收起抽屉，给到即时反馈
    else if (t.closest('.color-nav .color-item')) setDrawer(false);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (document.getElementById('color-drawer')?.hasAttribute('data-open')) {
      setDrawer(false);
    }
  });

  // 搜索过滤：事件委托在 document 上，页面切换后依然有效
  function handleSearch(input: HTMLInputElement) {
    const q = input.value.trim().toLowerCase();
    const scope = document.querySelector(input.dataset.target ?? '');
    if (!scope) return;
    let matched = 0;
    scope.querySelectorAll('.color-group').forEach((group) => {
      let visible = 0;
      group.querySelectorAll('[data-search]').forEach((item) => {
        const hit = !q || (item.getAttribute('data-search') ?? '').includes(q);
        item.toggleAttribute('hidden', !hit);
        if (hit) visible++;
      });
      group.toggleAttribute('hidden', visible === 0);
      matched += visible;
    });
    const empty = input.dataset.empty
      ? document.querySelector(input.dataset.empty)
      : null;
    if (empty) empty.toggleAttribute('hidden', !(q && matched === 0));
  }

  document.addEventListener('input', (e) => {
    const input = (e.target as Element).closest('.color-search');
    if (input instanceof HTMLInputElement) handleSearch(input);
  });
</script>
